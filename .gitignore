# dependencies
/node_modules
/.tools/

# next.js
/.next/
/out/
/.next-codex*/
/.pages-verify/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

